#export OMPI_MCA_btl="self,sm"  # TODO(correaa) add to cmakelist.txt?
export OMPI_MCA_rmaps_base_oversubscribe=yes
export MPIOVER=""  # --oversubscribe"
export CMAKE_CXX_COMPILER_LAUNCHER="ccache"

 (mkdir -p .build.g++              && cd .build.g++          && CXX=g++      MPI_OVERSUBSCRIBE=${MPIOVER} cmake .. -GNinja -DCMAKE_CXX_COMPILER_LAUNCHER="ccache" -DCMAKE_BUILD_TYPE=Debug              && cmake --build . && (ctest -j 6 || ctest -j 1 --rerun-failed --output-on-failure) ) || exit 666
 (mkdir -p .build.clang++-13       && cd .build.clang++-13   && CXX=clang++  MPI_OVERSUBSCRIBE=${MPIOVER} cmake .. -GNinja -DCMAKE_CXX_COMPILER_LAUNCHER="ccache"                                                              -DCMAKE_BUILD_TYPE=Debug                                                                                                                                                                  && cmake --build . && ctest -j 6 --output-on-failure) || exit 666
 (mkdir -p .build.g++.plus         && cd .build.g++.plus     && CXX=g++                                   cmake .. -GNinja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS="-D_GLIBCXX_ASSERTIONS -D_GLIBCXX_DEBUG -D_GLIBCXX_DEBUG_PEDANTIC" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_CXX_CPPCHECK="cppcheck;--force;--enable=all;--inline-suppr;--language=c++;--suppress=missingIncludeSystem;--suppress=normalCheckLevelMaxBranches;--suppress=syntaxError;--suppress=unusedFunction;--suppress=unmatchedSuppression;--std=c++17;--error-exitcode=666;-UEXCLUDE_CPPCHECK;-UMPI_DOUBLE_COMPLEX;-UMPI_C_DOUBLE_COMPLEX;-UMPI_C_LONG_DOUBLE_COMPLEX;-UMPI_C_FLOAT_COMPLEX;-UMPI_COMPLEX" && cmake --build . && ctest -j 6 --output-on-failure) || exit 666
 (mkdir -p .build.clang++.tidy     && cd .build.clang++.tidy && CXX=clang++  MPI_OVERSUBSCRIBE=${MPIOVER} cmake .. -GNinja -DCMAKE_CXX_COMPILER_LAUNCHER="ccache"                          -DCMAKE_CXX_CLANG_TIDY="clang-tidy" -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS="-stdlib=libc++ -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_DEBUG -fsanitize=address,undefined -fno-sanitize-recover=all" -DCMAKE_EXE_LINKER_FLAGS="-stdlib=libc++ -fsanitize=address,undefined"                                                                                        && cmake --build . && OMPI_MCA_btl_vader_single_copy_mechanism=none ASAN_OPTIONS=detect_leaks=0 ctest -j 6 --output-on-failure) || exit 666
 (mkdir -p .build.clang++20        && cd .build.clang++20    && CXX=clang++  MPI_OVERSUBSCRIBE=${MPIOVER} cmake .. -GNinja -DCMAKE_CXX_COMPILER_LAUNCHER="ccache" -DCMAKE_CXX_STANDARD=20                                       -DCMAKE_BUILD_TYPE=Debug                                                                                                                                                                  && cmake --build . && ctest -j 6 --output-on-failure) || exit 666
 (mkdir -p .build.g++20            && cd .build.g++20        && CXX=g++      MPI_OVERSUBSCRIBE=${MPIOVER} cmake .. -GNinja -DCMAKE_CXX_COMPILER_LAUNCHER="ccache" -DCMAKE_CXX_STANDARD=20                                       -DCMAKE_BUILD_TYPE=Debug                                                                                                                                                                  && cmake --build . && ctest -j 6 --output-on-failure) || exit 666
if [[ $(uname -m) != 'arm64' ]]; then
 (mkdir -p .build.nvcc             && cd .build.nvcc         && CUDACXX=nvcc MPI_OVERSUBSCRIBE=${MPIOVER} cmake .. -GNinja -DCMAKE_CXX_COMPILER_LAUNCHER="ccache"                                                             -DCMAKE_BUILD_TYPE=Debug -DENABLE_CUDA=1                                                                                                                                                  && cmake --build . && ctest -j 6 --output-on-failure) || exit 666
#(mkdir -p .build.nvhpc            && cd .build.nvhpc        && CXX=/opt/nvidia/hpc_sdk/Linux_x86_64/2025/compilers/bin/nvc++ cmake .. -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_STANDARD=20                                                                                                                                                                                                                                  && cmake --build . && ctest -j 6 --output-on-failure) || exit 666
fi

