# Verify a nonempty DMC report contains at least two distinct global walker counts.
# Input passed with -D: REPORT is the path to the .dmc.dat file.
file(STRINGS "${REPORT}" ROWS REGEX "^[ \t]*[0-9]")
if(NOT ROWS)
  message(FATAL_ERROR "No DMC steps found in ${REPORT}")
endif()

set(PREVIOUS_POPULATION "")
set(POPULATION_VARIES FALSE)
foreach(ROW IN LISTS ROWS)
  string(STRIP "${ROW}" ROW)
  string(REGEX REPLACE "[ \t]+" ";" FIELDS "${ROW}")
  list(LENGTH FIELDS FIELD_COUNT)
  if(FIELD_COUNT LESS 5)
    message(FATAL_ERROR "Incomplete DMC record in ${REPORT}: ${ROW}")
  endif()
  list(GET FIELDS 4 WALKERS)
  if(NOT WALKERS MATCHES "^[0-9]+([.][0-9]*)?([eE][+-]?[0-9]+)?$" OR NOT WALKERS GREATER 0)
    message(FATAL_ERROR "Invalid walker count in ${REPORT}: ${ROW}")
  endif()
  if(NOT PREVIOUS_POPULATION STREQUAL "" AND NOT WALKERS EQUAL PREVIOUS_POPULATION)
    set(POPULATION_VARIES TRUE)
    break()
  endif()
  set(PREVIOUS_POPULATION "${WALKERS}")
endforeach()

if(NOT POPULATION_VARIES)
  message(FATAL_ERROR "Walker population did not vary in ${REPORT}")
endif()
