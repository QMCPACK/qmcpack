#! /usr/bin/env python3

"""This script is designed to run Nexus's test suite using Pytest.

In general, it should only be run by users who have installed Nexus and
are looking to ensure their installation works in their environment.

Developers should NOT use this script to run the test suite as it will
suppress all warnings and fail fast, which is generally not desirable
for development.
"""

import sys
from contextlib import redirect_stdout
from pathlib import Path


def write_job_ref_table(output_file):
    """Write fresh machine job-command and submission-file references."""
    from nexus import testing
    from nexus.tests.test_machines import test_job_run_command, test_write_job

    try:
        testing.global_data['job_ref_table'] = True
        with output_file.open('w') as f:
            with redirect_stdout(f):
                print('Updated machine/job reference tables')
                print('===================================')
                print()
                print('Paste the entries below into job_run_ref in '
                      'tests/test_machines.py::test_job_run_command.')
                test_job_run_command()
                print()
                print('Paste the entries below into job_write_ref in '
                      'tests/test_machines.py::test_write_job.')
                test_write_job()
    finally:
        testing.global_data['job_ref_table'] = False

if sys.version_info[0:3] < (3, 10, 0):
    v = sys.version_info[0:3]
    print(
       f"Your version of Python ({v[0]}.{v[1]}.{v[2]}) is less than the minimum required for Nexus!\n"
        "To use Nexus, please install at least Python 3.10.0 or higher!\n\n"
        "If you already have a higher version installed, ensure that your Python\n"
        "environment is properly activated and your $PATH is set correctly."
    )
    sys.exit(1)

try:
    import pytest
except ImportError:
    print(
        "You must have pytest installed to run Nexus's testing suite!\n"
        "You can install it using one of the following commands:\n"
        "$ pip3 install pytest\n"
        "$ uv pip install pytest\n\n"
        "It is also recommended to install pytest-order to aid in potential debugging:\n"
        "$ pip3 install pytest-order\n"
        "$ uv pip install pytest-order\n"
    )
    sys.exit(1)

if __name__ == "__main__":

    import os

    if len(sys.argv) > 1 and sys.argv[1] == '--job-ref-table':
        if len(sys.argv) > 2:
            print('--job-ref-table does not accept additional arguments.')
            sys.exit(1)

        output_file = Path.cwd() / 'updated_job_ref_table.txt'
        write_job_ref_table(output_file)
        print(f'Updated job reference tables written to {output_file}')
        sys.exit(0)

    test_dir = Path(__file__).resolve().parent.parent / "tests"

    try:
        # This makes the output from pytest cleaner in that it doesn't print
        # the full path from the user's CWD to the Nexus libraries.
        os.chdir(test_dir)
    except PermissionError:
        pass

    pytest_args = []
    if len(sys.argv) > 1:
        if "-h" in sys.argv or "--help" in sys.argv:
            print(
                "Usage:\n"
                '$ nxs-test <pytest_args>\n'
                '$ nxs-test --job-ref-table\n\n'
                "See https://docs.pytest.org/en/stable/how-to/usage.html\n"
                "for specification of arguments.\n\n"
                "To select only specific tests, use `-k '<expr>'` from\n"
                "Pytest's section on specifying which tests to run.\n"
                "The other methods listed there are not supported by nxs-test.\n\n"
                "--job-ref-table writes updated machine job-command and submission-file\n"
                "reference entries to updated_job_ref_table.txt in the current directory."
            )
            sys.exit(1)

        for arg in sys.argv[1:]:
            pytest_args.append(arg)

    retcode = pytest.main([
        "--exitfirst",
        "--disable-warnings",
       *pytest_args,
       f"{test_dir}",
    ])

    sys.exit(retcode)
