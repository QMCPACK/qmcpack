#! /usr/bin/env python3
"""Script for reading and analyzing EinSpline HDF archives.

There are two primary functionalities, :func:`write_nk`, which writes the
electron density summed over k-points to an HDF5 archive, and :func:`kinetic`,
which reports the total and optionally the per-orbital kinetic energy of the
system.
"""

# Python standard library imports

import sys
from argparse import ArgumentParser
from dataclasses import dataclass
from pathlib import Path

if sys.version_info[0:3] < (3, 12, 0):  # pragma: no cover
    v = sys.version_info[0:3]
    print(
       f"Your version of Python ({v[0]}.{v[1]}.{v[2]}) is less than the minimum required for Nexus!\n"
        "To use Nexus, please install at least Python 3.12.0 or higher!\n\n"
        "If you already have a higher version installed, ensure that your Python\n"
        "environment is properly activated and your $PATH is set correctly."
    )
    sys.exit(1)

# Non-standard Python library imports
import numpy as np
import numpy.typing as npt

# Copied from qmca. Modification must done on qmca first
# Locate and import the closely coupled Nexus module
search_basepath = Path(__file__).resolve().parent.parent
nexus_library_search_path = search_basepath.parent
def find_nexus_modules():  # pragma: no cover
    import sys

    # "import nexus" will succeed if nexus directory exists without __init__.py in it.
    # Explicitly check the existence of nexus/__init__.py at the closely coupled location
    nexus_init = nexus_library_search_path / 'nexus/__init__.py'
    if not nexus_init.exists():
        print(
            '\n'
            'Expected file '+str(nexus_init)+' does not exist!\n'
            'Broken Nexus installation! Please follow Nexus manual regarding installation.\n')
        sys.exit(1)

    # check import of nexus modules
    sys.path.insert(0,str(nexus_library_search_path))
    try:
        import nexus
    except Exception as err:
        print('\nImporting Nexus modules failed for an unknown reason.'
              '\nThis is likely a developer error.'
              '\nFor more information, the original exception is reproduced below.'
              '\nPlease report this error to the Nexus developers.'+2*'\n')
        import traceback
        exc_type, exc_value, exc_traceback = sys.exc_info()
        exc_lines = traceback.format_exception(exc_type, exc_value, exc_traceback)
        for line in exc_lines:
            print(line.rstrip())
        print()
        sys.exit(1)

    # Sanity check. Most likely errors get caught earlier.
    # ensure closely coupled nexus module is in use.
    nexus_lib2 = Path(nexus.__file__).resolve().parent.parent
    if nexus_library_search_path != nexus_lib2:
        exe_full_path = Path(sys.argv[0]).resolve()
        print('\nNexus executable ' + str(exe_full_path) +
              '\n  Executable derived <nexus_root> = ' + str(nexus_library_search_path) +
              '\n  Module     derived <nexus_root> = ' + str(nexus_lib2) +
              '\nNexus executables and modules are not from the same installation!\n')
        sys.exit(1)
#end def find_nexus_modules

# Load Nexus modules
find_nexus_modules()
from nexus.developer import warn
from nexus.hdfreader import read_hdf
from nexus.nexus_version import nexus_version
from nexus.unit_converter import convert

try:
    import h5py
except ImportError as err:  # pragma: no cover
    msg = (
        f"{err!s}\n"
        "You must have h5py installed to use this script!"
        )
    raise ImportError(msg) from None


@dataclass
class KpointInfo:
    """Information about a specific k-point."""

    kpoint: npt.NDArray[np.floating]
    """K-point coordinates in units of the reciprocal lattice vectors."""
    kin: npt.NDArray[np.floating]
    """Kinetic energy at the specified k-point."""
    eig: npt.NDArray[np.floating]
    """Kohn-Sham eigenvalue for the specified state."""
    g_vecs: npt.NDArray[np.floating]
    """G-vectors at the k-point."""
    nk: npt.NDArray[np.floating]
    """Wavefunction density at the k-point, summed over all states."""
    ne: float
    """Number of electrons at the k-point, summed over all states."""


@dataclass
class EshdfData:
    """Data from the ES-HDF file."""

    orbfile: Path
    """Fully resolved path to orbital file."""
    E_fermi: float
    """Fermi energy in eV."""
    axes: npt.NDArray[np.floating]
    """Unit cell axes, shape ``(3, 3)``, in atomic units (a0)."""
    kaxes: npt.NDArray[np.floating]
    """K-space cell axes, shape ``(3, 3)``, in units of 1/a0."""
    nkpoints: int
    """Total number of k-points in the file."""
    nspins: int
    """Number of distinct spins."""
    data: dict[tuple[int, int], KpointInfo]
    """Information at a k-point index and spin, e.g. ``data[kpt_idx, spin]``"""


def read_eshdf_n_of_k_data(
    filename: Path,
    E_fermi: float,
    ncore: int = 0,
    nval: int = -1,
) -> EshdfData:
    """Read data from an ES-HDF archive and calculate some critical information.

    Notes
    -----
    The formulation used for the calculation of the kinetic energy (in Hartrees) is
    as follows:

    .. math::
        E_k = \\frac{1}{2} \\sum_{\\mathbf{G}} \\vert{}\\psi_{\\mathbf{G}}\\vert{}^2 \\vert{}\\mathbf{k} + \\mathbf{G}\\vert{}^2
    """
    h = read_hdf(filename, view=True)
    gvecs_unit = np.asarray(h["electrons"]["kpoint_0"]["gvectors"])
    axes = np.asarray(h["supercell"]["primitive_vectors"])
    kaxes = 2 * np.pi * np.linalg.inv(axes).T

    # Translate g-vectors from reciprocal lattice units to units of 1/a0
    gvecs = gvecs_unit @ kaxes
    kmag = np.sqrt((gvecs**2).sum(1))
    nkpts = int(h["electrons"]["number_of_kpoints"][0])
    nspins = int(h["electrons"]["number_of_spins"][0])
    data = {}
    for k in range(nkpts):
        kpt_idx  = f"kpoint_{k}"
        kp = h["electrons"][kpt_idx]
        # Convert k-point coordinate from reciprocal lattice units to units of 1/a0
        k_pos = np.dot(np.asarray(kp["reduced_k"]), kaxes)
        gvecs_at_k = gvecs.copy() + k_pos.T # Translate g-vectors by the current k-point

        # Kinetic energy at each g-vector, in Hartrees
        kinetic = (gvecs_at_k**2).sum(1) / 2
        for s in range(nspins):
            spin_idx = f"spin_{s}"
            kin_s = []
            eig_s = []
            nk_s = 0*kmag
            nelec_s = 0
            spin = h["electrons"][kpt_idx][spin_idx]
            eig = convert(np.array(spin["eigenvalues"]),'Ha','eV')
            nst = np.asarray(spin["number_of_states"], dtype=int)[0]
            nlast = nst
            if nval > 0:
              nlast = ncore + nval
            for st in range(ncore, nlast):
                e = eig[st]
                if e <= E_fermi:
                    state_idx = f"state_{st}"

                    # Complex expansion coefficients at each g-vector
                    psi = np.array(
                        h["electrons"][kpt_idx][spin_idx][state_idx]["psi_g"]
                    )
                    nk_orb = (psi**2).sum(1)
                    kin_orb = (kinetic*nk_orb).sum()
                    nelec_s += nk_orb.sum()
                    nk_s += nk_orb
                    kin_s.append(kin_orb)
                    eig_s.append(e)

            data[k,s] = KpointInfo(
                kpoint = np.array(kp["reduced_k"]),
                kin    = np.array(kin_s),
                eig    = np.array(eig_s),
                g_vecs = gvecs_at_k,
                nk     = nk_s,
                ne     = nelec_s,
            )

    res = EshdfData(
        orbfile  = filename,
        E_fermi  = E_fermi,
        axes     = axes,
        kaxes    = kaxes,
        nkpoints = nkpts,
        nspins   = nspins,
        data     = data,
    )
    return res
#end def read_eshdf_nofk_data


def kinetic(
    eshdf_filepath: Path,
    *,
    E_fermi: float,
    ncore: int,
    nval: int,
    norm_tol: float,
    orb_info: bool,
):

    eshdf_data = read_eshdf_n_of_k_data(
        filename=eshdf_filepath,
        E_fermi=E_fermi,
        ncore=ncore,
        nval=nval,
    )

    nkpoints = eshdf_data.nkpoints
    nspins   = eshdf_data.nspins

    ktot  = 0.0
    nspin = np.zeros((nspins,), dtype=int)
    kspin = np.zeros((nspins,), dtype=float)
    normspin = np.zeros((nspins,), dtype=float)
    norb  = []
    korb  = []
    eorb  = []
    kpidx = []
    for s in range(nspins):
        nsorb = []
        ksorb = []
        esorb = []
        kpsidx = []
        for k in range(nkpoints):
            dks = eshdf_data.data[k,s]
            nsorb.append(len(dks.kin))
            ksorb.extend(dks.kin)
            esorb.extend(dks.eig)
            kpsidx.extend([k]*len(dks.kin))
            normspin[s] += dks.ne

        nsorb = np.array(nsorb,dtype=int)
        ksorb = np.array(ksorb,dtype=float)
        esorb = np.array(esorb,dtype=float)
        kpsidx = np.array(kpsidx,dtype=int)

        order = esorb.argsort()
        esorb = esorb[order]
        ksorb = ksorb[order]
        kpsidx = kpsidx[order]

        ns = nsorb.sum()
        ks = ksorb.sum()

        ktot    += ks
        nspin[s] = ns
        kspin[s] = ks
        norb.append(nsorb)
        korb.append(ksorb)
        eorb.append(esorb)
        kpidx.append(kpsidx)

    def arr2str(a):
        return f'{a}'.strip().strip('[]')

    print()
    print(f'Number of spins              : {nspins}')
    print(f'Number kpoints               : {nkpoints}')
    print(f'Number of electrons per spin : {arr2str(nspin)}')
    print(f'Summed orbital norm per spin : {arr2str(normspin)}')
    print(f'Total kinetic energy         : {ktot} Ha')
    print(f'Kinetic energy per spin      : {arr2str(kspin)} Ha')

    norm_diff = np.abs(normspin - nspin).max()
    if norm_diff > norm_tol:
        warn(
            'Orbitals are not properly normalized!\n'
            f'Error in the summed norm is: {norm_diff}\n'
            f'This exceeds a tolerance of: {norm_tol:e}'
        )

    if not orb_info:
        return

    print('\nPer orbital kinetic energies')
    for s in range(nspins):
        spin = "up" if s == 0 else "down"

        print(f'  Spin {spin} energies')
        print(
            '    '
            f'{"index":>5}'
            f'{"kpoint_index":^14}'
            f'{"KS eig (eV)":^13}'
            f'{"kinetic (Ha)":>13}'
        )
        for i,(kpi,eig,kin) in enumerate(zip(kpidx[s], eorb[s], korb[s], strict=True)):
            print(
                '    '
                f'{i:^5}'
                f'{kpi:^14}'
                f'{eig:>11.6f}'
                f'{kin:>13.6f}'
            )
#end def kinetic


def write_nk(
    eshdf_filepath: Path,
    *,
    E_fermi: float,
    ncore: int,
    nval: int,
    ispin0: int,
    outfile: Path,
):
    eshdf_data = read_eshdf_n_of_k_data(
        filename=eshdf_filepath,
        E_fermi=E_fermi,
        ncore=ncore,
        nval=nval,
    )

    print(f'Writing n(k) to HDF5 {outfile}')
    klist = []
    nklist = []
    for key, val in eshdf_data.data.items():
        _, ispin = key
        if ispin != ispin0:
            continue
        klist.append(val.g_vecs)
        nklist.append(val.nk)
    kvecs = np.concatenate(klist, axis=0)
    nk = np.concatenate(nklist, axis=0)
    data = np.column_stack((kvecs, nk))
    with h5py.File(outfile, "w") as fp:
        fp.create_dataset(
            "data",
            data=data,
            compression="gzip",
            compression_opts=5,
        )
#end def write_nk


if __name__=='__main__':
    parser = ArgumentParser(
        prog="eshdf",
        description="Script for reading and analyzing EinSpline HDF archives.",
        epilog="Help for specific run types can be accessed with `eshdf {run_type} --help`",
    )
    parser.add_argument(
        "--version",
        action="version",
        version="%(prog)s {}.{}.{}".format(*nexus_version)
    )
    subparsers = parser.add_subparsers(
        title="Run Types",
        dest="run_type",
        required=True,
    )

    wnk_parser = subparsers.add_parser(
        "write_nk",
        description=(
            "Write the electron density at all k-points under the Fermi energy "
            "to an HDF archive."
        )
    )
    kin_parser = subparsers.add_parser(
        "kinetic",
        description=(
            "Calculate and print the per-k-point kinetic energy, "
            "optionally printing per-orbital information as well."
        )
    )

    for subparser in (wnk_parser, kin_parser):
        subparser.add_argument(
            "eshdf_file",
            type=Path,
            help="Path to HDF archive with data.",
        )
        subparser.add_argument(
            '--E-fermi',
            '--E_fermi',
            '--Ef',
            type=float,
            help='Fermi energy in eV.',
            required=True,
        )
        subparser.add_argument(
            '--ncore',
            type=int,
            default=0,
            help='Number of core states to exclude (default: %(default)s).',
        )
        subparser.add_argument(
            '--nval',
            type=int,
            default=-1,
            help='Number of valence states to include (default: %(default)s, i.e. all).',
        )

    kin_parser.add_argument(
        '--norm-tol',
        '--norm_tol',
        type=float,
        default=1e-6,
        help=(
            'Tolerance for whether or not the orbitals are considered normalized. '
            '(default: %(default)s).'
        ),
    )
    kin_parser.add_argument(
        '-o',
        '--orb',
        dest="orb_info",
        action='store_true',
        help=(
            'Print per orbital kinetic energies (default: %(default)s).'
        ),
    )

    wnk_parser.add_argument(
        '--outfile',
        '--output',
        type=Path,
        help='Output 3D momentum distribution to this file.',
        required=True,
    )
    wnk_parser.add_argument(
        '--ispin',
        type=int,
        default=0,
        help='Spin channel (default: %(default)s).',
    )

    args = parser.parse_args()
    arg_dict = vars(args)
    eshdf_file = args.eshdf_file.resolve(strict=True)
    if eshdf_file.suffix != '.h5':
        msg = (
            'File provided is not an HDF5 file.\n'
            'An ESHDF file must have a .h5 extension.\n'
            'Please check the path provided:\n'
            f'  {eshdf_file}'
        )
        raise ValueError(msg)

    match args.run_type:
        case "kinetic":
            kinetic(
                eshdf_filepath=eshdf_file,
                E_fermi=args.E_fermi,
                ncore=args.ncore,
                nval=args.nval,
                norm_tol=args.norm_tol,
                orb_info=args.orb_info,
            )
        case "write_nk":
            write_nk(
                eshdf_filepath=eshdf_file,
                E_fermi=args.E_fermi,
                ncore=args.ncore,
                nval=args.nval,
                ispin0=args.ispin,
                outfile=args.outfile,
            )
        case _:  # pragma: no cover
            msg = "This should be unreachable code!"
            raise RuntimeError(msg)
