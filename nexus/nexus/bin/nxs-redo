#! /usr/bin/env python3
"""Back up a simulation attempt into a subdirectory."""

import shutil
import sys
from argparse import ArgumentParser
from pathlib import Path

if sys.version_info[0:3] < (3, 12, 0):
    v = sys.version_info[0:3]
    print(
       f"Your version of Python ({v[0]}.{v[1]}.{v[2]}) is less than the minimum required for Nexus!\n"
        "To use Nexus, please install at least Python 3.12.0 or higher!\n\n"
        "If you already have a higher version installed, ensure that your Python\n"
        "environment is properly activated and your $PATH is set correctly."
    )
    sys.exit(1)

# Copied from qmca. Modification must done on qmca first
# Locate and import the closely coupled Nexus module
search_basepath = Path(__file__).resolve().parent.parent
nexus_library_search_path = search_basepath.parent
def find_nexus_modules():
    import sys

    # "import nexus" will succeed if nexus directory exists without __init__.py in it.
    # Explicitly check the existence of nexus/__init__.py at the closely coupled location
    nexus_init = nexus_library_search_path / 'nexus/__init__.py'
    if not nexus_init.exists():
        print(
            '\n'
            'Expected file '+str(nexus_init)+' does not exist!\n'
            'Broken Nexus installation! Please follow Nexus manual regarding installation.\n')
        sys.exit(1)

    # check import of nexus modules
    sys.path.insert(0,str(nexus_library_search_path))
    try:
        import nexus
    except Exception as err:
        print('\nImporting Nexus modules failed for an unknown reason.'
              '\nThis is likely a developer error.'
              '\nFor more information, the original exception is reproduced below.'
              '\nPlease report this error to the Nexus developers.'+2*'\n')
        import traceback
        exc_type, exc_value, exc_traceback = sys.exc_info()
        exc_lines = traceback.format_exception(exc_type, exc_value, exc_traceback)
        for line in exc_lines:
            print(line.rstrip())
        print()
        sys.exit(1)

    # Sanity check. Most likely errors get caught earlier.
    # ensure closely coupled nexus module is in use.
    nexus_lib2 = Path(nexus.__file__).resolve().parent.parent
    if nexus_library_search_path != nexus_lib2:
        exe_full_path = Path(sys.argv[0]).resolve()
        print('\nNexus executable ' + str(exe_full_path) +
              '\n  Executable derived <nexus_root> = ' + str(nexus_library_search_path) +
              '\n  Module     derived <nexus_root> = ' + str(nexus_lib2) +
              '\nNexus executables and modules are not from the same installation!\n')
        sys.exit(1)
#end def find_nexus_modules

find_nexus_modules()

from nexus.nexus_version import nexus_version


def main(
    paths_in: list[Path],
    *,
    verbose: bool,
    dry_run: bool,
):
    paths: dict[Path, tuple[list[Path], list[Path]]] = {}
    for path in paths_in:
        if not (path.exists() or path.is_dir()):
            continue

        attempts = []
        contents = []
        for item in sorted(path.iterdir()):
            isdir = item.is_dir()
            if item.stem.startswith("attempt") and isdir:
                attempts.append(item)
            else:
                contents.append(item)

        paths[path] = (attempts, contents)

    if len(paths) == 0:
        msg = "No simulation directories found!"
        raise RuntimeError(msg)

    if verbose:
        print("Backing up attempted sim runs...\n")

    for path, (attempts, contents) in paths.items():
        if verbose:
            print(f"  Backing up files in {path}")

        attempt_dir = path / f"attempt{len(attempts) + 1}"
        if len(contents) == 0:
            if verbose:
                print("    No contents to backup!")
            continue

        if dry_run:
            print(
                f"    Would have created backup of {len(contents)} files in:\n"
                f"      {attempt_dir}\n"
            )
            continue

        if verbose:
            print(
                f"    Creating backup of {len(contents)} files in:\n"
                f"      {attempt_dir}"
            )

        if not dry_run and len(contents) > 0:
            attempt_dir.mkdir()
            for item in contents:
                shutil.move(item, attempt_dir)

        if verbose:
            print("  Done!\n")

    if verbose:
        print("Backup Complete!")

if __name__ == "__main__":
    parser = ArgumentParser(
        prog="nxs-redo",
        description="""
            Take the contents of a simulation directory and back them up into a
            subdirectory labeled `attemptN` where `N` is the attempt number.
        """,
    )
    parser.add_argument(
        "--version",
        action="version",
        version="%(prog)s {}.{}.{}".format(*nexus_version)
    )
    parser.add_argument(
        "paths",
        type=Path,
        nargs="+",
        help=(
            "Either a single file that contains the names of simulation run directories "
            "each on their own line, or multiple simulation directories, or a glob pattern "
            "that points to multiple simulation directories."
        ),
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Print detailed information. (default: %(default)s)."
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help=(
            "Print directories to be backed up as previous attempts, but don't "
            "actually do anything. Automatically sets `verbose=True`. "
            "(default: %(default)s)"
        )
    )

    args = parser.parse_args()

    paths_in: list[Path] = [path.resolve() for path in args.paths]
    dry_run: bool  = args.dry_run
    verbose: bool = args.verbose or dry_run # Always print with dry run

    if (  # Passed a file with paths inside it
        len(paths_in) == 1
        and (in_file := paths_in[0]).is_file()
    ):
        text = in_file.read_text()
        paths_in = []
        for line in text.splitlines():
            tokens = line.split()
            if len(tokens) > 0:
                paths_in.append(Path(tokens[-1]).resolve())

    invalid_paths = {path for path in paths_in if not path.is_dir()}
    paths_in = [i for i in paths_in if i not in invalid_paths]
    if len(invalid_paths) > 0 and verbose:
        print("The following provided paths do not exist or are not directories:")
        for path in sorted(invalid_paths):
            print(f"  {path}")
        print()

    non_sim_dirs = {
        path for path in paths_in
        if not any(f.stem.startswith("sim") and f.is_dir() for f in path.iterdir())
    }
    paths_in = [i for i in paths_in if i not in non_sim_dirs]
    if len(non_sim_dirs) > 0 and verbose:
        print("Encountered non-simulation directory in supplied paths:")
        for non_sim_dir in sorted(non_sim_dirs):
            print(f"  {non_sim_dir}")
        print()

    main(
        paths_in,
        verbose=verbose,
        dry_run=dry_run,
    )
