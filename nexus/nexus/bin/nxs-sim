#! /usr/bin/env python3

import argparse
import difflib
import shutil
import sys
import textwrap
from argparse import ArgumentParser
from collections.abc import Sequence
from pathlib import Path

if sys.version_info[0:3] < (3, 12, 0):  # pragma: no cover
    v = sys.version_info[0:3]
    print(
       f"Your version of Python ({v[0]}.{v[1]}.{v[2]}) is less than the minimum required for Nexus!\n"
        "To use Nexus, please install at least Python 3.12.0 or higher!\n\n"
        "If you already have a higher version installed, ensure that your Python\n"
        "environment is properly activated and your $PATH is set correctly."
    )
    sys.exit(1)

# Copied from qmca. Modification must done on qmca first
# Locate and import the closely coupled Nexus module
search_basepath = Path(__file__).resolve().parent.parent
nexus_library_search_path = search_basepath.parent
def find_nexus_modules():  # pragma: no cover
    import sys

    # "import nexus" will succeed if nexus directory exists without __init__.py in it.
    # Explicitly check the existence of nexus/__init__.py at the closely coupled location
    nexus_init = nexus_library_search_path / 'nexus/__init__.py'
    if not nexus_init.exists():
        print(
            '\n'
            'Expected file '+str(nexus_init)+' does not exist!\n'
            'Broken Nexus installation! Please follow Nexus manual regarding installation.\n')
        sys.exit(1)

    # check import of nexus modules
    sys.path.insert(0,str(nexus_library_search_path))
    try:
        import nexus
    except Exception as err:
        print('\nImporting Nexus modules failed for an unknown reason.'
              '\nThis is likely a developer error.'
              '\nFor more information, the original exception is reproduced below.'
              '\nPlease report this error to the Nexus developers.'+2*'\n')
        import traceback
        exc_type, exc_value, exc_traceback = sys.exc_info()
        exc_lines = traceback.format_exception(exc_type, exc_value, exc_traceback)
        for line in exc_lines:
            print(line.rstrip())
        print()
        sys.exit(1)

    # Sanity check. Most likely errors get caught earlier.
    # ensure closely coupled nexus module is in use.
    nexus_lib2 = Path(nexus.__file__).resolve().parent.parent
    if nexus_library_search_path != nexus_lib2:
        exe_full_path = Path(sys.argv[0]).resolve()
        print('\nNexus executable ' + str(exe_full_path) +
              '\n  Executable derived <nexus_root> = ' + str(nexus_library_search_path) +
              '\n  Module     derived <nexus_root> = ' + str(nexus_lib2) +
              '\nNexus executables and modules are not from the same installation!\n')
        sys.exit(1)
#end def find_nexus_modules

find_nexus_modules()

from nexus import nexus_version
from nexus.developer import load, save


class SimTool:

    indicators = (
        "setup",
        "sent_files",
        "submitted",
        "finished",
        "failed",
        "got_output",
        "analyzed",
    )

    fields = frozenset(indicators)

    def vprint(self, msg: str):
        if self.verbose:
            print(msg)

    def __init__(self, paths: list[Path], *, verbose: bool):
        self.paths = paths
        self.verbose = verbose
        self.vprint("Loading sim images:")
        for pth in self.paths:
            self.vprint(f"  ./{pth.relative_to(Path.cwd(), walk_up=True)}")
        self.sims = [load(path) for path in self.paths]
        self.vprint("Done!")
    #end def __init__


    def write_state(self, fields: Sequence[str] = ()):
        if len(fields) == 0:
            fields = self.indicators

        field_len = max(map(len, fields)) + 1
        for i, path in enumerate(self.paths):
            sim = self.sims[i]
            print(path)
            for f in fields:
                print(f"  {f + ':':<{field_len}} {sim[f]}")
            print()
    #end def write_state


    def write_state_all(self):
        for i, path in enumerate(self.paths):
            sim = self.sims[i]
            print(path)
            print(sim)
            print()
    #end def write_state_all


    def backup(self):
        for path in self.paths:
            backup_file = path.parent / f"backup_{path.name}"
            self.vprint(
                f"Creating backup of ./{path.relative_to(Path.cwd(), walk_up=True)}"
            )
            shutil.copy(path, backup_file)
    #end def backup


    def restore(self):
        for path in self.paths:
            backup_file = path.parent / f"backup_{path.name}"
            self.vprint(
                f"Restoring backup of ./{path.relative_to(Path.cwd(), walk_up=True)}"
            )
            shutil.copy(backup_file, path)
    #end def restore


    def set_indicators(self, inds: Sequence[str], *, val: bool = True):
        for i, path in enumerate(self.paths):
            self.vprint(f"./{path.relative_to(Path.cwd(), walk_up=True)}")
            sim = self.sims[i]
            spacing = max(map(len, inds)) + 1
            for ind in inds:
                if ind == "submitted" and val is False:
                    self.vprint(
                        f"  {ind + ':':<{spacing}} {sim[ind]} -> {val} "
                        "(and setting sim.process_id to None)"
                    )
                    sim.process_id = None
                else:
                    self.vprint(f"  {ind + ':':<{spacing}} {sim[ind]} -> {val}")

                sim[ind] = val
            save(sim, path)
    #end def set_indicators
#end class SimTool


if __name__ == "__main__":
    parser = ArgumentParser(
        prog="nxs-sim",
        usage=(
            f"nxs-sim [command] [-h] [paths ...] [{{{', '.join(SimTool.indicators)}}} ...]"
        ),
        description=textwrap.dedent("""
            Tool for controlling the status indicators of a simulation or
            creating/restoring backups of a simulation pickle.

            Commands
            --------
            `show`:     Show the selected simulation status indicators.
            `showall`:  Show all simulation properties.
            `complete`: Set simulation status flags to indicate it is completed.
            `reset`:    Reset all simulation status flags.
            `set`:      Set the specified simulation status flags to `True`.
            `unset`:    Set the specified simulation status flags to `False`.
            `backup`:   Make a backup of the specified simulation pickle at `sim_backup.p`.
            `restore`:  Take a backup of the specified simulation pickle at `sim_backup.p`
                      and rename it back to `sim.p`.
        """),
        epilog=(
            "Indicators are required in `set`, `unset`, and are optional in `show`. "
            "Other subcommands do not accept indicators."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--version",
        action="version",
        version="%(prog)s {}.{}.{}".format(*nexus_version)
    )
    parser.add_argument(
        "command",
        metavar="command",
        choices={"show", "showall", "complete", "reset", "set", "unset", "backup", "restore"},
        help="Available commands: {%(choices)s}"
    )
    parser.add_argument(
        "paths_or_inds",
        nargs="*",
        help=(
            "Paths pointing to `sim.p` files and/or indicators. "
            f"Available indicators are {{{',\xa0'.join(SimTool.indicators)}}}"
            # \xa0 is non-breaking space
        ),
        default=Path("./sim.p"),
    )
    parser.add_argument(
        "--verbose",
        "-v",
        action="store_true",
        help="Print detailed information. (default: %(default)s)"
    )

    args = parser.parse_args()

    command: str = args.command
    paths_or_inds: list[str] = args.paths_or_inds
    verbose: bool = args.verbose

    paths: list[Path] = []
    indicators: list[str] = []
    unrecognized_args = []
    for item in paths_or_inds:
        if (path := Path(item)).exists() and path.name == "sim.p":
            paths.append(path.resolve())
        elif item in SimTool.fields:
            indicators.append(item)
        else:
            close_matches = difflib.get_close_matches(item, SimTool.fields)
            if len(close_matches) > 0:
                close_match = close_matches[0]
            else:
                close_match = None
            unrecognized_args.append((item, close_match))

    if len(unrecognized_args) > 0:
        msg = "Unrecognized arguments:\n"
        for arg, close_match in unrecognized_args:
            extra = f" - Did you mean `{close_match}`?" if close_match is not None else ""
            msg += f"  {arg}{extra}\n"
        parser.exit(1, message=msg)

    if command in {"set", "unset"} and len(indicators) == 0:
        msg = (
            f"No indicators specified for command `{command}`, see "
            "`nxs-sim --help` for available indicators."
        )
        parser.exit(1, message=msg)

    if len(paths) == 0:
        msg = "No simulation images found!"
        parser.exit(1, message=msg)

    st = SimTool(paths, verbose=verbose)

    match command:
        case "show":
            st.write_state(indicators)
        case "showall":
            st.write_state_all()
        case "complete":
            indicators = SimTool.fields - {"failed"}
            st.set_indicators(indicators)
        case "reset":
            st.set_indicators(st.indicators, val=False)
        case "set":
            st.set_indicators(indicators, val=True)
        case "unset":
            st.set_indicators(indicators, val=False)
        case "backup":
            st.backup()
        case "restore":
            st.restore()
        case _:  # pragma: no cover
            raise RuntimeError("Unreachable!")
