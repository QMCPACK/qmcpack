! Original Nexus regression input; not derived from Quantum ESPRESSO examples.
&CONTROL
  calculation = 'scf'
  prefix = 'nexus_argon'
  outdir = './nexus_test_tmp'
  pseudo_dir = './pseudo'
/
&SYSTEM
  ibrav = 1
  celldm(1) = 9.25
  nat = 1
  ntyp = 1
  nspin = 1
  ecutwfc = 32.0
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 2.0d-9
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Ar 39.948 Ar.nexus-test.UPF
ATOMIC_POSITIONS crystal
  Ar 0.0 0.0 0.0
K_POINTS automatic
  5 5 5 1 1 1
