! Original Nexus regression input; not derived from Quantum ESPRESSO examples.
&CONTROL
  calculation = 'relax'
  prefix = 'nexus_h2'
  outdir = './nexus_test_tmp'
  pseudo_dir = './pseudo'
  forc_conv_thr = 3.0d-5
  nstep = 40
/
&SYSTEM
  ibrav = 1
  celldm(1) = 18.0
  nat = 2
  ntyp = 1
  nspin = 1
  ecutwfc = 28.0
  assume_isolated = 'martyna-tuckerman'
/
&ELECTRONS
  conv_thr = 4.0d-10
  mixing_beta = 0.55
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  H 1.00794 H.nexus-test.UPF
ATOMIC_POSITIONS angstrom
  H 4.50 4.50 4.09  0 0 1
  H 4.50 4.50 4.91  0 0 1
K_POINTS gamma
