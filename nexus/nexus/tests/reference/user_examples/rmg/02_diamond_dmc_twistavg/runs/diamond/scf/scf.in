# control options

calculation_mode       = "Quench Electrons"
energy_convergence_criterion = "1.00000000e-09"
max_scf_steps          = "100"


# cell parameter options

atomic_coordinate_type = "Cell Relative"
kpoint_distribution    = "4"
kpoint_is_shift        = "0 0 0"
kpoint_mesh            = "4 4 4"
lattice_units          = "Bohr"
lattice_vector         = "3.37316115 3.37316115 0.00000000 0.00000000 3.37316115 3.37316115 3.37316115 0.00000000 3.37316115"
wavefunction_grid      = "32 32 32"


# pseudopotential related options

localize_localpp       = "false"
localize_projectors    = "false"
pseudopotential        = "
C    C.BFD.xml
"


# kohn sham solver options

kohn_sham_solver       = "davidson"


# exchange correlation options

exchange_correlation_type = "pbe"


# orbital occupation options

occupations_type       = "Fixed"
states_count_and_occupation = "4 2.0 1 0.0"


# charge density mixing options

charge_density_mixing  = "0.50000000"
charge_mixing_type     = "Broyden"


# diagonalization options

subdiag_driver         = "lapack"


# undocumented options

atoms                  = "
C      0.000000000000   0.000000000000   0.000000000000
C      0.250000000000   0.250000000000   0.250000000000
"
