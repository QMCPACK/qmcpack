description = "C2 laptop exact-exchange analyzer run"
calculation_mode = "Exx Only"
start_mode = "Restart From File"

wavefunction_grid = "16 16 16"
potential_grid_refinement = "2"
internal_pseudo_type = "nc_accuracy"

bravais_lattice_type = "Cubic Face Centered"
lattice_units = "Bohr"
a_length = "6.72"
b_length = "6.72"
c_length = "6.72"
atomic_coordinate_type = "Cell Relative"
atoms = "
C  0.25  0.25  0.25
C  0.00  0.00  0.00
"

kpoint_mesh = "1 1 1"
kpoint_is_shift = "0 0 0"
kohn_sham_solver = "davidson"
subdiag_driver = "lapack"
input_wave_function_file = "Waves/wave.out"
exx_mode = "Local fft"
exx_integrals_filepath = "exx_integrals"
