description = "C2 laptop SCF analyzer run"
calculation_mode = "Quench Electrons"
start_mode = "LCAO Start"

wavefunction_grid = "16 16 16"
potential_grid_refinement = "2"
internal_pseudo_type = "nc_accuracy"

bravais_lattice_type = "Cubic Face Centered"
lattice_units = "Bohr"
a_length = "6.72"
b_length = "6.72"
c_length = "6.72"
atomic_coordinate_type = "Cell Relative"
atoms = "
C  0.25  0.25  0.25
C  0.00  0.00  0.00
"

kpoint_mesh = "1 1 1"
kpoint_is_shift = "0 0 0"
kohn_sham_solver = "davidson"
subdiag_driver = "lapack"
charge_mixing_type = "Broyden"
charge_density_mixing = "0.5"
max_scf_steps = "30"
energy_convergence_criterion = "1.0e-7"
rms_convergence_criterion = "1.0e-7"
output_wave_function_file = "Waves/wave.out"
write_qmcpack_restart = "true"
write_data_period = "1"
