description = "C2 laptop constant-temperature MD analyzer run"
calculation_mode = "Constant Temperature And Energy"
start_mode = "LCAO Start"

wavefunction_grid = "16 16 16"
potential_grid_refinement = "2"
internal_pseudo_type = "nc_accuracy"
bravais_lattice_type = "Cubic Face Centered"
lattice_units = "Bohr"
a_length = "6.72"
b_length = "6.72"
c_length = "6.72"
atomic_coordinate_type = "Cell Relative"
atoms = "
C  0.25  0.25  0.25
C  0.00  0.00  0.00
"

kpoint_mesh = "1 1 1"
kohn_sham_solver = "davidson"
subdiag_driver = "lapack"
charge_mixing_type = "Broyden"
max_scf_steps = "20"
energy_convergence_criterion = "1.0e-7"
rms_convergence_criterion = "1.0e-10"
max_md_steps = "2"
ionic_time_step = "1.0"
md_randomize_velocity = "true"
md_temperature = "100.0"
md_temperature_control = "Anderson Rescaling"
