description = "Graphene slab SCF seed for laptop STM analyzer run"
calculation_mode = "Quench Electrons"
start_mode = "LCAO Start"

wavefunction_grid = "16 16 64"
potential_grid_refinement = "2"
internal_pseudo_type = "nc_accuracy"
bravais_lattice_type = "Hexagonal Primitive"
lattice_units = "Angstrom"
a_length = "2.46"
b_length = "2.46"
c_length = "9.84"
crds_units = "Angstrom"
atomic_coordinate_type = "Absolute"
atoms = "
C  0.00  0.00000000  0.0
C  1.23  0.71014083  0.0
"

kpoint_mesh = "2 2 1"
kpoint_is_shift = "0 0 0"
kohn_sham_solver = "davidson"
subdiag_driver = "lapack"
max_scf_steps = "30"
energy_convergence_criterion = "1.0e-7"
rms_convergence_criterion = "1.0e-7"
unoccupied_states_per_kpoint = "4"
output_wave_function_file = "Waves/stm_seed"
write_data_period = "1"
