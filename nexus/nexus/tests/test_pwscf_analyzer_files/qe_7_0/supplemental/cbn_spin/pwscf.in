&CONTROL
  calculation = 'scf'
  verbosity = 'high'
  restart_mode = 'from_scratch'
  prefix = 'cbn_spin'
  outdir = './tmp'
  pseudo_dir = '../../additional_pseudos'
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 2
  celldm(1) = 6.82
  nat = 2
  ntyp = 2
  ecutwfc = 300.0
  ecutrho = 1200.0
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.02
  nbnd = 8
  nspin = 2
  starting_magnetization(1) = 0.5
  starting_magnetization(2) = -0.5
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.5
  diagonalization = 'david'
/
ATOMIC_SPECIES
  B 10.81 B.ccECP.upf
  N 14.01 N.ccECP.upf
ATOMIC_POSITIONS crystal
  B 0.000 0.000 0.000
  N 0.250 0.250 0.250
K_POINTS automatic
  3 3 3 0 0 0
