&CONTROL
  calculation = 'vc-relax'
  verbosity = 'high'
  restart_mode = 'from_scratch'
  prefix = 'cbn_vc_relax'
  outdir = './tmp'
  pseudo_dir = '../../additional_pseudos'
  tstress = .true.
  tprnfor = .true.
  nstep = 3
/
&SYSTEM
  ibrav = 0
  celldm(1) = 6.82
  nat = 2
  ntyp = 2
  ecutwfc = 300.0
  ecutrho = 1200.0
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.5
  diagonalization = 'david'
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press = 0.0
  press_conv_thr = 0.5
  cell_dofree = 'all'
/
ATOMIC_SPECIES
  B 10.81 B.ccECP.upf
  N 14.01 N.ccECP.upf
ATOMIC_POSITIONS crystal
  B 0.000 0.000 0.000
  N 0.255 0.245 0.250
CELL_PARAMETERS alat
 -0.500  0.000  0.500
  0.000  0.500  0.500
 -0.500  0.500  0.000
K_POINTS automatic
  2 2 2 0 0 0
